#!/bin/bash
set -euo pipefail
umask 077
dnf install -y docker jq python3 tar gzip
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.39.4/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod 755 /usr/local/lib/docker/cli-plugins/docker-compose
# Wait for Terraform's volume attachment. Match its unique serial, never the first disk.
for attempt in $(seq 1 120); do
 disk=$(lsblk -dn -o PATH,SERIAL | awk '$2=="${volume_serial}" {print $1}')
 [ -n "$disk" ] && break
 sleep 5
done
[ -n "$disk" ] || { echo 'Data volume not attached'; exit 1; }
if ! blkid "$disk" >/dev/null; then mkfs.ext4 "$disk"; fi
mkdir -p /srv/company-rag/data
uuid=$(blkid -s UUID -o value "$disk")
printf 'UUID=%s /srv/company-rag/data ext4 defaults,nofail 0 2\n' "$uuid" >> /etc/fstab
mount /srv/company-rag/data
mkdir -p /srv/company-rag/data/documents
chown 10001:10001 /srv/company-rag/data/documents
chmod 700 /srv/company-rag/data/documents
mkdir -p /opt/company-rag
aws s3 cp 's3://${bucket}/${release_key}' /tmp/company-rag.tar.gz --region '${region}'
printf '%s  %s\n' '${checksum}' /tmp/company-rag.tar.gz | sha256sum -c -
tar -xzf /tmp/company-rag.tar.gz -C /opt/company-rag
printf '%s' '${deployment_b64}' | base64 -d > /opt/company-rag/deployment.json
chmod +x /opt/company-rag/ops/* /opt/company-rag/deploy/postgres-init.sh
/opt/company-rag/ops/fetch-env
registry=$(python3 -c 'import json;print(json.load(open("/opt/company-rag/deployment.json"))["environment"]["BACKEND_IMAGE"].split("/")[0])')
aws ecr get-login-password --region '${region}' | docker login --username AWS --password-stdin "$registry"
cp /opt/company-rag/deploy/company-rag.service /etc/systemd/system/
cp /opt/company-rag/deploy/company-rag-backup.service /etc/systemd/system/
cp /opt/company-rag/deploy/company-rag-backup.timer /etc/systemd/system/
systemctl daemon-reload
systemctl enable --now company-rag.service company-rag-backup.timer
