#!/usr/bin/env python3
import sys, time, urllib.request, json

base = sys.argv[1].rstrip("/")
for attempt in range(60):
    try:
        data = json.load(
            urllib.request.urlopen(
                base + "/auth/realms/company/.well-known/openid-configuration",
                timeout=10,
            )
        )
        assert data["issuer"] == base + "/auth/realms/company"
        try:
            urllib.request.urlopen(base + "/api/me", timeout=10)
        except urllib.error.HTTPError as e:
            if e.code == 401:
                print(
                    "Identity provider and application are ready. Complete administrator setup."
                )
                sys.exit(0)
    except Exception:
        pass
    time.sleep(5)
raise SystemExit(
    "Application not ready. Inspect cloud-init, systemd and container logs."
)
