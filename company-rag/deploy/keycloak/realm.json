{
  "realm": "company",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "employee"
      },
      {
        "name": "finance"
      },
      {
        "name": "hr"
      },
      {
        "name": "company-admin"
      }
    ]
  },
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "auth": "${SMTP_AUTH}",
    "starttls": "${SMTP_STARTTLS}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}"
  },
  "clients": [
    {
      "clientId": "company-rag",
      "enabled": true,
      "secret": "${OIDC_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PUBLIC_URL}/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "${PUBLIC_URL}"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm roles in identity",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "${PUBLIC_URL}/*"
      }
    },
    {
      "clientId": "employee-provisioner",
      "enabled": true,
      "secret": "${PROVISIONER_SECRET}",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "${COMPANY_ADMIN_EMAIL}",
      "enabled": true,
      "emailVerified": false,
      "firstName": "Company",
      "lastName": "Administrator",
      "requiredActions": [
        "UPDATE_PASSWORD",
        "VERIFY_EMAIL"
      ],
      "realmRoles": [
        "company-admin",
        "employee"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${COMPANY_ADMIN_PASSWORD}",
          "temporary": true
        }
      ]
    },
    {
      "username": "service-account-employee-provisioner",
      "enabled": true,
      "serviceAccountClientId": "employee-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ]
}
