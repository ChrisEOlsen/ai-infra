[Unit]
Description=Company RAG Compose stack
Requires=docker.service
After=docker.service network-online.target
RequiresMountsFor=/srv/company-rag/data
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/company-rag
ExecStartPre=/opt/company-rag/ops/fetch-env
ExecStart=/usr/bin/docker compose --env-file .env -f deploy/compose.yml up -d --wait --wait-timeout 240
ExecStop=/usr/bin/docker compose --env-file .env -f deploy/compose.yml down --timeout 150
TimeoutStartSec=600
TimeoutStopSec=240
[Install]
WantedBy=multi-user.target
